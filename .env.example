# =======================================================
# VNAV HOMELAB ENVIRONMENT CONFIGURATION
# =======================================================

# Port on which the web dashboard is exposed
DASHBOARD_PORT=3050

# Hostname displayed across telemetry headers
HOMELAB_HOSTNAME=vnavhomelab

# Telemetry sampling interval in seconds (default: 2.0)
SAMPLING_INTERVAL=2.0

# Bounded in-memory telemetry buffer points (default: 120)
RING_BUFFER_SIZE=120

# Admin secret key for privileged operations (container restart/stop, diagnostic terminal)
ADMIN_API_KEY=vnav-homelab-key-2026

# Tailscale Node Settings
TAILSCALE_IP=100.92.50.31
TAILSCALE_DOMAIN=raspberrypi.tailcc3db3.ts.net

# Directory boundary for secured File Manager
ALLOWED_ROOT_PATH=/home/pi/homelab
